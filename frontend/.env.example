# Frontend environment — copy to .env.local and edit.
#
# All VITE_* vars are baked at BUILD time (Vite static-replaces them).
# Restart `npm run dev` after changing any of these.

# Backend REST base URL. Empty string = same origin (production build
# served from the backend). For local dev against the loopback backend,
# leave empty — Vite's dev server proxies /api to localhost:3003 via
# the proxy config in vite.config.ts.
VITE_API_URL=

# Backend WebSocket URL. Empty = derived from window.location.hostname.
# Set explicitly when running the frontend on a different host than the
# backend (e.g. Vite on laptop, backend in Docker).
VITE_WS_URL=

# Control-plane bearer token — REQUIRED when the backend is running with
# CONTROL_PLANE_TOKEN set (which is mandatory whenever CONTROL_PLANE_HOST
# is not 127.0.0.1/localhost). The frontend sends this as
# `Authorization: Bearer <token>` on every REST request except /api/health,
# and as ?token=<token> on the /ws upgrade. The backend uses a
# constant-time comparison (src/lib/authToken.ts).
#
# Leave empty for the default loopback dev setup where the backend has no
# token configured.
VITE_CONTROL_PLANE_TOKEN=
