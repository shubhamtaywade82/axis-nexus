{
  "name": "axis-nexus",
  "version": "0.4.1",
  "description": "Axis Nexus — Autonomous Options Trading System for DhanHQ v2",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/server.ts",
    "start:paper": "TRADING_MODE=paper ts-node src/server.ts",
    "start:sandbox": "TRADING_MODE=sandbox ts-node src/server.ts",
    "start:live": "TRADING_MODE=live ts-node src/server.ts",
    "start:headless": "ts-node src/index.ts",
    "start:headless:paper": "TRADING_MODE=paper ts-node src/index.ts",
    "start:headless:sandbox": "TRADING_MODE=sandbox ts-node src/index.ts",
    "start:headless:live": "TRADING_MODE=live ts-node src/index.ts",
    "dev": "ts-node-dev --transpile-only --respawn src/index.ts",
    "dev:server": "ts-node-dev --transpile-only --respawn src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:all": "npm run dev:server & npm run dev:frontend",
    "dev:all:paper": "TRADING_MODE=paper npm run dev:all",
    "dev:all:sandbox": "TRADING_MODE=sandbox npm run dev:all",
    "dev:all:live": "TRADING_MODE=live npm run dev:all",
    "dev:stop": "npm run stop",
    "stop": "npm run stop:server && npm run stop:frontend",
    "stop:all": "npm run stop",
    "stop:server": "fuser -k 3003/tcp 2>/dev/null || true; pkill -f '[t]s-node.*(server|index)\\.ts|[t]s-node-dev|[s]andbox-supertrend-watch' 2>/dev/null || true",
    "stop:frontend": "fuser -k 5175/tcp 5173/tcp 2>/dev/null || true; pkill -f '[v]ite' 2>/dev/null || true",
    "subscribe:indices": "ts-node scripts/subscribe-indices.ts",
    "backtest:long-option-policy": "ts-node scripts/backtest-long-option-policy.ts",
    "watch:sandbox-supertrend": "ts-node scripts/sandbox-supertrend-watch.ts",
    "test": "jest --forceExit",
    "test:coverage": "jest --forceExit --coverage --coverageThreshold='{\"global\":{\"branches\":40,\"functions\":55,\"lines\":58,\"statements\":55}}'",
    "test:live-smoke": "ts-node scripts/live-smoke.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "oxlint"
    ]
  },
  "dependencies": {
    "@nemesis-oss/dhanhq-sdk": "^1.1.0",
    "@nemesis-oss/ollama-sdk": "^1.24.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "pino-pretty": "^13.2.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testEnvironment": "node",
    "testTimeout": 30000,
    "forceExit": true,
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/__tests__/setup.ts"
    ]
  }
}
