# DhanHQ API Credentials
DHAN_CLIENT_ID=your_client_id
DHAN_PIN=your_pin
DHAN_TOTP_SECRET=your_base32_totp_secret
DHANHQ_BASE_URL=https://api.dhan.co/v2
DHAN_AUTH_BASE_URL=https://auth.dhan.co

# External Auth Authority (Rails API Token Endpoint)
DHAN_AUTH_PROVIDER_URL=http://localhost:3000
DHAN_AUTH_PROVIDER_TOKEN=api_operator_token

# Default Base Trading Mode (overridden by .env.paper, .env.sandbox, or .env.live)
# See .env.paper.example, .env.sandbox.example, and .env.live.example for mode-specific overrides.
TRADING_MODE=paper
AUTONOMOUS_SCAN_ENABLED=true
# Set false when testing adaptive-supertrend only — the LLM agent scan is
# separate from the 1m/5m supertrend scanner and will place its own sandbox orders.
# AUTONOMOUS_SCAN_ENABLED=false
# Faster supertrend scans during sandbox dry-runs (default 60000 ms)
# ADAPTIVE_SUPERTREND_SCAN_INTERVAL_MS=30000
# Entry paths: crossover (1m flip into 5m), continuation (already aligned), both
# ADAPTIVE_SUPERTREND_ENTRY_MODE=both
# Peak-profit exit policy for long options (default on)
# LONG_OPTION_POLICY_ENABLED=true
# Live monitor while dev:server runs: npm run watch:sandbox-supertrend
# WATCH_POLL_MS=10000
# WATCH_HISTORY=5

# Risk Engine (also live-tunable via POST /api/control/risk-limits)
RISK_DAILY_MAX_LOSS=50000
RISK_MAX_QUANTITY=500

# Ollama LLM (optional — agent runs fall back to deterministic mode)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Ollama Cloud (optional — same env var names as the paper-broker app, so
# the same API keys work in both unchanged). When any OLLAMA_API_KEY_N is
# set, the agent uses OLLAMA_CLOUD_MODEL via Ollama Cloud instead of the
# local daemon above, with automatic failover across whichever keys are set
# (a rate-limited/dead key falls through to the next one). Not capped at
# 3 — keep numbering sequentially (_1, _2, _3, _4, ...) with no gaps and
# add as many as you have accounts for; no code change needed.
OLLAMA_API_KEY_1=
OLLAMA_API_KEY_2=
OLLAMA_API_KEY_3=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
# Free-tier models per ollama.com/settings (Usage tab): gemma4:31b,
# gpt-oss:120b, gpt-oss:20b, nemotron-3-nano:30b, nemotron-3-super,
# nemotron-3-ultra. Verify your own account's list before changing this —
# a paid/different account may have a different free set.
OLLAMA_CLOUD_MODEL=gemma4:31b

# Redis & Pub/Sub
REDIS_URL=redis://127.0.0.1:6379/0

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/axis_nexus_development

# Server Port
PORT=3003

# Logging (structured Pino JSON on stdout + daily logs/YYYY-MM-DD.jsonl file;
# pino-pretty on stdout only outside production)
LOG_LEVEL=info              # fatal|error|warn|info|debug|trace
LOG_DIR=                    # defaults to <repo>/logs
SERVICE_NAME=axis-nexus
APP_VERSION=dev
BUS_BRIDGE_BUDGET=300       # max bus→stdout log lines per minute (flood guard)
CLIENT_LOG_RATE_LIMIT=120   # max frontend log batches per minute per IP

# Telegram notifications (WARN/ERROR/SYSTEM eventBus alerts) — same bot as
# algo_scalper_api. Leave blank to disable; no-ops silently either way.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Control plane hardening (src/server.ts). Defaults are safe for the local
# single-operator dev setup — CORS is locked to the exact frontend origin
# and the server binds to loopback only, regardless of these being set.
#
# MANDATORY when CONTROL_PLANE_HOST is not 127.0.0.1/localhost/::1 — an
# unauthenticated order-placement API on a network interface is the most
# dangerous misconfiguration for an autonomous trading server. Boot aborts
# without it in that case.
# OPTIONAL on loopback: when set, every REST route (except /api/health) and
# the /ws upgrade require it (Bearer header / ?token= query param
# respectively). Comparison is constant-time (lib/authToken.ts). The current
# frontend does not yet send it, so setting this on loopback will lock the
# operator out of their own running system until the frontend is wired up.
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_ORIGIN=http://localhost:5175
CONTROL_PLANE_TOKEN=

# PostgreSQL connection pool size (src/db.ts). Default 10 matches the prior
# hardcoded value and is fine for paper mode. Raise to ~20 for live/broker
# deployments where RiskEngine.evaluate() + autonomy.cycle() +
# BrokerPortfolioSource polling run concurrently under fast markets.
PG_POOL_MAX=10
